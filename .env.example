# OCR engine defaults to FREE local Tesseract (no key necessary).
BYBE_OCR_ENGINE=local
# Only if you explicitly choose paid cloud OCR:
# BYBE_OCR_ENGINE=gemini
# Copy this file to .env (never commit the real key).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
# Optional future feature, disabled by default.
BYBE_ENABLE_LIVE_VOICE=false
